#!/usr/bin/env bash

# CUDA 安装脚本
# 该脚本负责安装已下载的 CUDA、cuDNN 和 TensorRT 包

# 获取脚本所在目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# 加载工具函数
source "$PROJECT_DIR/lib/utils.sh"

# 加载配置
load_config "$PROJECT_DIR/config/cuvm.yaml"

# 打印使用说明
usage() {
  echo "用法: install [组件] [版本] [选项]"
  echo ""
  echo "组件:"
  echo "  cuda      安装 CUDA"
  echo "  cudnn     安装 cuDNN"
  echo "  tensorrt  安装 TensorRT"
  echo ""
  echo "选项:"
  echo "  --cuda-version <version>  指定 CUDA 版本（仅对 cuDNN 和 TensorRT 有效）"
  echo ""
  echo "示例:"
  echo "  ./install cuda 11.8"
  echo "  ./install cudnn 8.9.7 --cuda-version 11.8"
  echo "  ./install tensorrt 8.6.1 --cuda-version 11.8"
}

# 安装 CUDA
install_cuda() {
  local version="$1"
  local filename="cuda_${version}_linux.run"
  local filepath="$CUVB_DOWNLOADS_DIR/$filename"
  local install_path="$CUVB_VERSIONS_DIR/cuda-$version"
  
  print_info "正在安装 CUDA $version..."
  
  # 检查下载文件是否存在
  if [[ ! -f "$filepath" ]]; then
    print_error "错误：未找到 CUDA $version 的下载文件 $filepath"
    print_error "请先运行 download cuda $version 下载文件"
    return 1
  fi
  
  # 检查是否已安装
  if [[ -d "$install_path" ]]; then
    print_info "CUDA $version 已安装在 $install_path"
    return 0
  fi
  
  # 创建安装目录
  mkdir -p "$install_path"
  
  # 这里应该执行实际的安装过程
  # 由于 CUDA 安装比较复杂，这里仅作为示例
  print_warning "警告：这里仅作为示例，实际安装过程需要更多步骤"
  print_info "创建占位符目录: $install_path"
  print_info "CUDA $version 安装成功"
}

# 安装 cuDNN
install_cudnn() {
  local version="$1"
  local cuda_version="$2"
  local filename="cudnn-linux-x86_64-${version}_cuda${cuda_version}_-archive.tar.xz"
  local filepath="$CUVB_DOWNLOADS_DIR/$filename"
  local install_path="$CUVB_VERSIONS_DIR/cudnn-$version-cuda-$cuda_version"
  
  print_info "正在安装 cuDNN $version for CUDA $cuda_version..."
  
  # 检查下载文件是否存在
  if [[ ! -f "$filepath" ]]; then
    print_error "错误：未找到 cuDNN $version for CUDA $cuda_version 的下载文件 $filepath"
    print_error "请先运行 download cudnn $version --cuda-version $cuda_version 下载文件"
    return 1
  fi
  
  # 检查是否已安装
  if [[ -d "$install_path" ]]; then
    print_info "cuDNN $version for CUDA $cuda_version 已安装在 $install_path"
    return 0
  fi
  
  # 创建安装目录
  mkdir -p "$install_path"
  
  # 这里应该执行实际的安装过程
  # cuDNN 通常是解压 tar.xz 文件并将文件复制到 CUDA 目录
  print_warning "警告：这里仅作为示例，实际安装过程需要解压文件并复制到 CUDA 目录"
  print_info "创建占位符目录: $install_path"
  print_info "cuDNN $version for CUDA $cuda_version 安装成功"
}

# 安装 TensorRT
install_tensorrt() {
  local version="$1"
  local cuda_version="$2"
  local filename="TensorRT-${version}-Linux.x86_64-gnu.cuda-${cuda_version}.tar.gz"
  local filepath="$CUVB_DOWNLOADS_DIR/$filename"
  local install_path="$CUVB_VERSIONS_DIR/tensorrt-$version-cuda-$cuda_version"
  
  print_info "正在安装 TensorRT $version for CUDA $cuda_version..."
  
  # 检查下载文件是否存在
  if [[ ! -f "$filepath" ]]; then
    print_error "错误：未找到 TensorRT $version for CUDA $cuda_version 的下载文件 $filepath"
    print_error "请先运行 download tensorrt $version --cuda-version $cuda_version 下载文件"
    return 1
  fi
  
  # 检查是否已安装
  if [[ -d "$install_path" ]]; then
    print_info "TensorRT $version for CUDA $cuda_version 已安装在 $install_path"
    return 0
  fi
  
  # 创建安装目录
  mkdir -p "$install_path"
  
  # 这里应该执行实际的安装过程
  # TensorRT 通常是解压 tar.gz 文件
  print_warning "警告：这里仅作为示例，实际安装过程需要解压文件"
  print_info "创建占位符目录: $install_path"
  print_info "TensorRT $version for CUDA $cuda_version 安装成功"
}

# 解析命令行参数
if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

COMPONENT="$1"
shift

case "$COMPONENT" in
  cuda)
    VERSION="$1"
    if [[ -z "$VERSION" ]]; then
      print_error "错误：请指定 CUDA 版本"
      usage
      exit 1
    fi
    install_cuda "$VERSION"
    ;;
    
  cudnn)
    VERSION="$1"
    CUDA_VERSION=""
    shift
    
    # 解析选项
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --cuda-version)
          CUDA_VERSION="$2"
          shift 2
          ;;
        *)
          print_error "未知选项: $1"
          usage
          exit 1
          ;;
      esac
    done
    
    if [[ -z "$VERSION" ]]; then
      print_error "错误：请指定 cuDNN 版本"
      usage
      exit 1
    fi
    
    if [[ -z "$CUDA_VERSION" ]]; then
      print_error "错误：请指定 CUDA 版本"
      usage
      exit 1
    fi
    
    install_cudnn "$VERSION" "$CUDA_VERSION"
    ;;
    
  tensorrt)
    VERSION="$1"
    CUDA_VERSION=""
    shift
    
    # 解析选项
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --cuda-version)
          CUDA_VERSION="$2"
          shift 2
          ;;
        *)
          print_error "未知选项: $1"
          usage
          exit 1
          ;;
      esac
    done
    
    if [[ -z "$VERSION" ]]; then
      print_error "错误：请指定 TensorRT 版本"
      usage
      exit 1
    fi
    
    if [[ -z "$CUDA_VERSION" ]]; then
      print_error "错误：请指定 CUDA 版本"
      usage
      exit 1
    fi
    
    install_tensorrt "$VERSION" "$CUDA_VERSION"
    ;;
    
  *)
    print_error "未知组件: $COMPONENT"
    usage
    exit 1
    ;;
esac